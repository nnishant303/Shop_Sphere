{
  "name": "shop-sphere",
  "private": true,
  "version": "0.1.0",
  "description": "Shop Sphere ecommerce monorepo.",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "npm run dev --workspace @shopsphere/frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "react-router-dom": "^7.18.3"
  }
}
